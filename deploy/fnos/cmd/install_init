#!/bin/bash

APP_NAME=rustfs-fnos
CONTAINER=rustfs-fnos
COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
CFG_DIR="${TRIM_PKGETC}"
VAR_DIR="${TRIM_PKGVAR}"
CRED_DIR="${CFG_DIR}/credentials"
SETTINGS="${CFG_DIR}/settings.env"
LOG_FILE="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
API_PORT="${TRIM_SERVICE_PORT:-9200}"

compose() { docker compose -p "${APP_NAME}" -f "${COMPOSE_FILE}" "$@"; }

say() { echo "[${APP_NAME}] $*"; }

# 失败：既要让管理员在终端看见，也要写进 TRIM_TEMP_LOGFILE 让应用中心显示原因
fail() {
  { echo "[${APP_NAME}] ERROR: $*" >>"${LOG_FILE}"; } 2>/dev/null || true
  echo "[${APP_NAME}] ERROR: $*" >&2
  exit 1
}

# 告警：不中断安装，但必须留痕（真机首轮：包用户缺 docker 组时 docker info 会失败）
warn() {
  { echo "[${APP_NAME}] WARN: $*" >>"${LOG_FILE}"; } 2>/dev/null || true
  echo "[${APP_NAME}] WARN: $*" >&2
}

# 日志：整个重定向一起吞掉。若 ${VAR_DIR} 尚不可写，单靠 `>>file 2>/dev/null`
# 仍会让 bash 往 shell 的 stderr 抛 "No such file or directory"（真机首轮 F4）
trace() {
  { mkdir -p "${VAR_DIR}" && echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"${VAR_DIR}/lifecycle.log"; } 2>/dev/null || true
}

# >>> BEGIN: writable-probe（本段在 install_init / config_init / install_callback / config_callback 中必须逐字相同；preflight §5c 会比对）
# 以「容器运行用户」（${TRIM_UID}:${TRIM_GID}）身份真实写一个探针文件，判断目录是否真的可写。
#
# 为什么不看属主：fnOS 在卷上挂了一层 TrimACL（挂载项 trimacl + system.trim_acl xattr），
# 它会给包用户 uid 单独挂一条 rwxpdDaAeEc 的 ACE。真机实测：目录属主是 admin(1000)、
# 包用户 uid 996 也能在里面建文件（与该用户是否在 Users 组无关）。旧代码用「属主 UID 比对」
# 把这种目录判成不可写，逼用户去 sudo chown —— 其实根本不需要。
#
# 为什么 root 必须降权：root 写任何目录都成功，用 root 探测等于没检查。
# 统一的「属主」显示：用户名:组名（UID n）；解析不到用户名时退回 UID n。
# 四个脚本共用这一份，避免出现「UID 1000」与「admin:Users」两种写法（真机第十一轮指出）。
owner_desc() { # $1=路径
  local p="$1" uname_ u gname_ n
  n="$(stat -c '%u' "${p}" 2>/dev/null || echo '')"
  uname_="$(stat -c '%U' "${p}" 2>/dev/null || echo '')"
  gname_="$(stat -c '%G' "${p}" 2>/dev/null || echo '')"
  if [ -n "${n}" ] && [ -n "${uname_}" ] && [ "${uname_}" != "UNKNOWN" ] && [ -n "${gname_}" ] && [ "${gname_}" != "UNKNOWN" ]; then
    printf '%s:%s（UID %s）' "${uname_}" "${gname_}" "${n}"
  elif [ -n "${n}" ]; then
    printf 'UID %s' "${n}"
  else
    printf '未知'
  fi
}

# 数据目录「操作意图」归一：向导没有控件联动，所以必须靠这份规则消歧。
#   mode=default   → 恢复默认位置（忽略文本框）
#   mode=custom    → 必须填文本框，否则报错
#   mode=keep / 空 → 不改；但若文本框非空，按 custom 处理（兼容只填路径的老习惯）
resolve_data_request() { # $1=mode $2=text → "<action>|<path>"，action=keep|custom|default|error
  local mode="${1:-keep}" text="${2:-}"
  text="$(printf '%s' "${text}" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  case "${mode}" in
    default) printf 'default|' ;;
    custom)
      if [ -z "${text}" ]; then
        printf 'error|选择了「改到指定目录」但没有填写路径'
      else
        printf 'custom|%s' "${text}"
      fi ;;
    keep|'')
      if [ -n "${text}" ]; then printf 'custom|%s' "${text}"; else printf 'keep|'; fi ;;
    *) printf 'error|未知的数据目录操作：%s' "${mode}" ;;
  esac
}

# DATA_DIR_MODE 由事实派生（不再由「是否来自向导」决定）：
#   挂载点 ${VAR_DIR}/<subdir> 是符号链接 → custom（数据物理上在别处）
#   不是链接且实际路径就是它      → default
# 注意：不能直接 readlink -f 两边再比 —— 自定义目录时链接会解析到同一个目标，
# 那样会永远判成 default（本轮自测就踩到这一下）。
derive_data_mode() { # $1=实际数据目录 $2=应用目录里的挂载点（var/<subdir>）
  local d="$1" l="$2"
  [ -L "${l}" ] && { printf 'custom'; return 0; }
  if [ "$(readlink -f "${d}" 2>/dev/null || echo "${d}")" = "$(readlink -f "${l}" 2>/dev/null || echo "${l}")" ]; then
    printf 'default'
  else
    printf 'custom'
  fi
}

# 把「曾经被改名保留下来的旧默认库」告诉用户（${VAR_DIR}/<subdir>.old-*）。
# 只在「目标回到默认位置」时调用：那时应用用的是新建的空库，用户会以为数据丢了，
# 而旧库其实完整保留着（默认→自定义时被改名，不是删除）。
report_stale_default_data() { # $1=VAR_DIR $2=subdir 名 $3=当前默认目录
  local var="$1" sub="$2" cur="$3" d sz cnt uid gid found=0
  uid="${TRIM_UID:-$(id -u 2>/dev/null)}"
  gid="${TRIM_GID:-$(id -g 2>/dev/null)}"
  for d in "${var}/${sub}".old-*; do
    [ -d "${d}" ] || continue
    found=1
    sz="$(du -sh "${d}" 2>/dev/null | awk '{print $1}')"
    cnt="$(find "${d}" -mindepth 1 2>/dev/null | wc -l | tr -d ' ')"
    say "旧数据目录（完整保留，未删除）：${d}　体积 ${sz:-?}，条目 ${cnt}"
  done
  [ "${found}" = "1" ] || return 0
  say "说明：这些是你之前「切到自定义目录」时，原来的默认数据被整体改名保留在这里（一个字节都没删）。"
  say "      现在应用用的是新建的空数据目录 ${cur}，所以原来建的桶/对象在这里看不到。"
  say "      要搬回来：先在应用中心「停止」应用，再复制粘贴执行下面几条——"
  for d in "${var}/${sub}".old-*; do
    [ -d "${d}" ] || continue
    say "  sudo cp -a \"${d}/.\" \"${cur}/\""
  done
  say "  sudo chown -R ${uid}:${gid} \"${cur}\""
  say "      （源写成「旧目录/.」表示把里面的内容复制进目标目录，不会多套一层子目录；同名文件以旧库为准覆盖）"
  say "      搬完在应用中心「停止 → 启动」；确认数据都在后，可以自行删除 ${var}/${sub}.old-* 目录。"
  return 0
}

# ---- 端口解析与 compose 渲染（四个 *_init / *_callback 共用）----
# 为什么需要：manifest.service_port 是静态字段（写 9200），向导改不了它；用户要能自定义 API 端口，
# 就只能让「真值」落在 settings.env，并把这真值渲染进 compose 的 ports 行。
# （compose 读不到 settings.env，也不保证拿得到 wizard_* —— 所以不赌插值，直接渲染文件。）
#
# 优先级（wizard 只代表「本次操作」，所以它在最前）：
#   ① wizard_api_port（本次向导填的）
#   ② settings.env 的 API_PORT（上次已生效的）
#   ③ TRIM_SERVICE_PORT（平台按 manifest 注入，通常 9200）
#   ④ 9200
resolve_api_port() {
  local p=""
  if [ -n "${wizard_api_port:-}" ]; then
    p="${wizard_api_port}"
  elif [ -r "${SETTINGS}" ]; then
    p="$(awk -F= '/^[[:space:]]*API_PORT[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2;exit}' "${SETTINGS}" 2>/dev/null)"
  fi
  [ -n "${p}" ] || p="${TRIM_SERVICE_PORT:-9200}"
  case "${p}" in ''|*[!0-9]*) p="${TRIM_SERVICE_PORT:-9200}" ;; esac
  printf '%s' "${p}"
}

# 把 API / 控制台端口渲染进 compose 的 ports 两行（幂等；只认以 :9000 / :9001 结尾的映射行）
# 为什么改文件而不是用 ${VAR} 插值：平台创建容器时用的是它自己的 compose 调用，
# 我们无法保证它带上我们的环境变量；而 base compose 文件在 TRIM_APPDEST 下、包用户可写（真机已验证）。
render_compose_ports() { # $1=compose 文件 $2=API 端口 $3=控制台端口
  local f="$1" api="$2" con="$3"
  [ -f "${f}" ] || return 1
  case "${api}" in ''|*[!0-9]*) return 1 ;; esac
  case "${con}" in ''|*[!0-9]*) return 1 ;; esac
  sed -i "s|^\([[:space:]]*-[[:space:]]*\)\"[^\"]*:9000\"|\1\"${api}:9000\"|" "${f}" 2>/dev/null || return 1
  sed -i "s|^\([[:space:]]*-[[:space:]]*\)\"[^\"]*:9001\"|\1\"${con}:9001\"|" "${f}" 2>/dev/null || return 1
  return 0
}


# 把真实 API 端口渲染进 gateway.conf 的注入脚本（幂等：按 `var p = <数字>;` 重写）。
# 为什么需要：窗口内打开时，页面要替用户把「服务器地址」写进 localStorage，端口必须是对的
# （真源是 settings.env 的 API_PORT；渲染后 gateway 容器挂载的这份配置即生效于新请求）。
render_gateway_conf() { # $1=gateway.conf 路径  $2=API 端口
  local f="$1" api="$2" n_before n_after
  [ -f "${f}" ] || return 1
  case "${api}" in ''|*[!0-9]*) return 1 ;; esac

  # 形态契约（真机踩过，别改）：端口必须写成「单独一条语句、分号结尾」的 `var p = <数字>;`。
  # 逗号连写（`var k=...,p = 9200,...`）JS 语义等价，但本函数的正则匹配不到 →
  # 渲染静默不做 → **装出来的端口会停在模板值**（这类“看起来只是排版”的差异最难查）。
  # 所以这里先探一次：数量为 0 时区分「文件不对」和「写法不对」，后者给出可操作提示。
  n_before="$(grep -o 'var p = [0-9]*;' "${f}" 2>/dev/null | wc -l | tr -d ' ')"
  if [ "${n_before:-0}" -eq 0 ]; then
    if grep -v '^[[:space:]]*#' "${f}" 2>/dev/null | grep -Eq 'p = [0-9]+[,)]'; then
      warn "gateway.conf 的端口写成了逗号形态（p = <数字>,）—— 渲染只认「单独一条语句、分号结尾」的 var p = <数字>;，
  当前写法不会被替换，端口会停在模板值（不是 ${api}）。请把注入脚本改回：
    var p = <数字>;var k=\"rustfs-server-host\",s=window.localStorage,h=location.hostname;…
  （逗号连写只是排版差异，但会让本函数完全失效。）"
    fi
    return 1                                        # 一个都没有 → 文件形态不对
  fi

  # 全量替换：注入脚本在多个精确 location 里各有一份，统计出现次数（不是行数）并全部替换。
  sed -i -E "s/(var p = )[0-9]+;/\1${api};/g" "${f}" 2>/dev/null || return 1
  n_after="$(grep -o "var p = ${api};" "${f}" 2>/dev/null | wc -l | tr -d ' ')"
  [ "${n_after}" = "${n_before}" ] || return 1      # 有漏替换 → 报错，别静默

  # 零残留：目标端口不是模板值 9200 时，渲染后不该再出现模板值（防止“部分替换”）
  if [ "${api}" != "9200" ] && grep -q 'var p = 9200;' "${f}" 2>/dev/null; then
    return 1
  fi
  return 0
}

probe_writable() { # $1=已存在的目录；0=可写 1=不可写
  local dir="$1" p cur_uid target_uid target_gid
  [ -d "${dir}" ] || return 1
  cur_uid="$(id -u 2>/dev/null || echo '?')"
  target_uid="${TRIM_UID:-${cur_uid}}"
  target_gid="${TRIM_GID:-$(id -g 2>/dev/null || echo "${cur_uid}")}"
  p="${dir}/.rustfs-write-probe.$$"

  # 情况①：当前是 root 且目标用户不是 root → 降权后再写（否则恒真）
  if [ "${cur_uid}" = "0" ] && [ "${target_uid}" != "0" ]; then
    if command -v setpriv >/dev/null 2>&1; then
      trace "write-probe: cur_uid=0 → 降权至 ${target_uid}:${target_gid} 后探测 ${dir}"
      if setpriv --reuid "${target_uid}" --regid "${target_gid}" --clear-groups \
           sh -c 'umask 022; : > "$1"' _ "${p}" 2>/dev/null; then
        rm -f "${p}" 2>/dev/null || true
        return 0
      fi
      rm -f "${p}" 2>/dev/null || true
      return 1
    fi
    warn "环境里没有 setpriv，无法以 UID ${target_uid} 降权探测写权限；按可写处理（若实际不可写，会在启动阶段暴露）。"
    return 0
  fi

  # 情况②：当前身份与容器用户不一致且没有 root 权限 → 只能以当前身份探测，并明确告知
  if [ "${cur_uid}" != "${target_uid}" ]; then
    warn "当前身份 UID ${cur_uid} 与容器运行用户 UID ${target_uid} 不同，且无 root 权限降权；写探测以当前身份进行。"
  fi

  trace "write-probe: 以 uid=$(id -u) 直接探测 ${dir}（未降权）"
  if ( umask 022; : > "${p}" ) 2>/dev/null; then
    rm -f "${p}" 2>/dev/null || true
    return 0
  fi
  rm -f "${p}" 2>/dev/null || true
  return 1
}
# <<< END: writable-probe

# >>> BEGIN: data-dir-check（本段在 cmd/install_init 与 cmd/config_init 中必须逐字相同；preflight §5c 会比对）
normalize_data_dir() { # $1=原始值 → 规范化绝对路径（去尾斜杠与空白）；空串表示「用默认位置」
  local d="$1"
  d="$(printf '%s' "${d}" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -z "${d}" ] && { printf ''; return 0; }
  while [ "${#d}" -gt 1 ] && [ "${d%/}" != "${d}" ]; do d="${d%/}"; done
  printf '%s' "${d}"
}

# 数据目录判定：分层，顺序不能乱
#   L1 形态：绝对路径 / 无 .. / 无空白
#   L2 系统目录：/etc /usr /bin /sbin /lib* /boot /dev /proc /sys /root /run /tmp /var 及其子路径
#   L3 卷根：/volN 本身（应该建子目录）
#   L4 @ 应用目录层：路径里出现「以 @ 开头的一段」= 平台/应用目录区，只放行本项目自己的前缀
#   L5 可写探测：以容器运行用户身份真实写一次（不看属主）
#
# L4 是最容易写错的一层，真机事故就出在这里：
#   早先写成 "${PROG_PARENT}/*"，而 PROG_PARENT=$(dirname $(dirname $TRIM_APPDEST)) = /vol1，
#   于是 /vol1 下**所有**用户目录都被拒（用户填 /vol1/1000/RustFS 直接失败并触发回滚）。
#   正确做法是拦「@ 那一层」，绝不能少一层变成 /vol*/*。
check_data_dir() { # $1=规范化后的路径  $2=允许前缀（空格分隔：本项目自己的 appdata/appconf/apptemp/apphome）
  local d="$1" allow="$2" dd probe avail_kb a ok uid gid me grp owner mode

  # ---- L1 形态 ----
  [ -n "${d}" ] || fail "数据目录为空。"
  [ "${d}" = "/" ] && fail "不能把根目录 / 当数据目录。请改到存储空间里的普通目录，例如 /vol1/rustfs-data。"
  case "${d}" in
    /*) : ;;
    *) fail "数据目录必须是绝对路径（以 / 开头）：${d}" ;;
  esac
  case "${d}" in
    *..*) fail "数据目录不能包含 .. ：${d}" ;;
  esac
  case "${d}" in
    *[[:space:]]*) fail "数据目录不能包含空格：${d}（建议用 rustfs-data 这类不含空格的目录名）" ;;
  esac
  dd="${d}/"

  # ---- L2 系统目录（精确层与子路径都拦）----
  case "${dd}" in
    /etc/*|/usr/*|/bin/*|/sbin/*|/lib/*|/lib64/*|/boot/*|/dev/*|/proc/*|/sys/*|/root/*|/run/*|/tmp/*)
      fail "数据目录不能放在系统目录下：${d}
  请改到存储空间里的普通目录，例如 /vol1/rustfs-data。" ;;
    /var/*)
      fail "数据目录不能放在 /var 下：${d}
  请改到存储空间里的普通目录，例如 /vol1/rustfs-data。" ;;
  esac

  # ---- L3 卷根本身 ----
  if printf '%s' "${d}" | grep -Eq '^/vol[0-9]+$'; then
    fail "请不要把整个存储空间的根目录当数据目录：${d}
  请在它下面建一个子目录，例如 ${d}/rustfs-data。"
  fi

  # ---- L4 @ 应用目录层（只拦平台/应用目录区，放行本项目自己的那几个前缀）----
  case "${dd}" in
    */@*/*)
      ok=0
      for a in ${allow}; do
        [ -n "${a}" ] || continue
        case "${dd}" in "${a}/"*) ok=1 ;; esac
      done
      if [ "${ok}" != "1" ]; then
        fail "数据目录不能放在应用/平台目录里：${d}
  这类目录（@appdata / @appconf / @appcenter / @appshare / @apptemp 等）由平台管理，
  会被应用的安装、卸载与失败回滚影响。请改到存储空间里的普通目录，例如 /vol1/rustfs-data。"
      fi ;;
  esac

  # 自检钩子：只验路径规则、不碰磁盘（scripts/ 里的测试与 CI 用；正常安装不会设置它）
  if [ "${RUSTFS_DATA_DIR_PATH_ONLY:-0}" = "1" ]; then
    printf 'PATH-OK %s\n' "${d}"
    return 0
  fi

  # ---- L5 可写探测（以容器运行用户身份真实写一次，绝不看属主）----
  probe="${d}"
  while [ ! -e "${probe}" ] && [ "${probe}" != "/" ]; do probe="$(dirname "${probe}")"; done
  [ -d "${probe}" ] || fail "数据目录的上级路径不存在：${probe}"

  uid="${TRIM_UID:-$(id -u 2>/dev/null)}"
  gid="${TRIM_GID:-$(id -g 2>/dev/null)}"
  me="$(id -un 2>/dev/null || echo "UID $(id -u)")"
  grp="$(id -gn 2>/dev/null || echo "GID $(id -g)")"
  trace "data-dir check d=${d} probe=${probe} cur_uid=$(id -u) cur_user=${me} target_uid=${uid} target_gid=${gid}"

  # ---- L5a 平台代建豁免（v1.0.5）----
  # 真机事故（.212 首次安装 + 默认位置）：目标 /vol1/@appdata/<app>/data 尚不存在，
  # 最近已存在祖先是 /vol1/@appdata（root:root 755）→ 包用户不能在平台根里 mkdir →
  # 被判「成因B」→ install error 10237 + rollback。
  # 但那台机上其它应用目录的属主都是各自的包用户，说明 @appdata/<app> 是**平台在安装过程中**
  # 创建并 chown 的 —— 我们在平台建目录之前就要求父目录可写，太早了。
  #
  # 三条件**同时**满足才豁免，缺一不可：
  #   ① 目标在**本项目自己的**应用目录之下（allow 前缀）；
  #   ② 目标本身不存在；
  #   ③ 最近已存在的祖先**恰好是平台根**（/vol*/@appdata 等，不能更深也不能更浅）。
  # 其余情况一律照旧真实写探测 —— root:root 700/755 这类真不可写仍然拦得住；
  # 目录建好后 install_callback 会再真实写一次（二次保险）。
  defer_probe=0
  if [ ! -e "${d}" ]; then
    under_own=0
    for a in ${allow}; do
      [ -n "${a}" ] || continue
      case "${d}/" in "${a}/"*) under_own=1 ;; esac
    done
    if [ "${under_own}" = "1" ]; then
      case "${probe}" in
        /vol*/@appdata|/vol*/@appconf|/vol*/@apptemp|/vol*/@apphome)
          defer_probe=1
          say "数据目录 ${d} 尚不存在，将由应用中心在安装过程中创建；可写性会在目录建好后自动复验。"
          trace "data-dir defer d=${d} probe=${probe}（平台代建豁免：在自己应用目录下 + 不存在 + 祖先为平台根）" ;;
      esac
    fi
  fi

  if [ "${defer_probe}" != "1" ] && ! probe_writable "${probe}"; then
    owner="$(owner_desc "${probe}")"
    mode="$(stat -c '%a' "${probe}" 2>/dev/null || echo 未知)"
    if [ -d "${d}" ]; then
      fail "数据目录不可写：${d}
  当前身份：UID ${uid}、组 ${gid}；该目录属主 ${owner}，权限 ${mode}。

【为什么会这样（首次安装最常见）】
  fnOS 不是用传统的「属主/组/其他」判断权限，而是用 TrimACL 给**具体的应用用户**单独授权
  （一条 allow uid:${uid} …）。本应用的用户是在**安装过程中**才被创建的：
  如果你**先**在「文件管理」里建好这个目录、**后**装应用，那时候本应用的用户还不存在，
  这个目录因此没被授权 —— 安装时它以 ${uid} 身份去写，就写不进去。

【三条路，按省事程度排序，任选一条】

  1) 最省事：向导里「数据存放位置」保持「不修改」（用默认位置）先把应用装上；
     装完再到「应用中心 → 本应用 → 设置」里把数据目录改成 ${d} —— 那时用户已存在，平台会补授权。

  2) 如果你确认父目录对本应用可写，可把这个**空目录**删掉，让应用自己创建：
       sudo rmdir ${d}
     注意：在 /vol1/1000 这类「用户空间根」下通常**不行** —— fnOS 只对它下面被单独授权的子目录放行（实测）。

  3) 最确定：直接把这个目录交给本应用（改属主）：
       sudo chown -R ${uid}:${gid} ${d}
       sudo chmod 750 ${d}

改完回应用中心重新安装即可。本次安装没有改动你的任何数据。

  如果这是**首次安装**、而且你用的是**默认数据位置**（/vol<N>/@appdata/…），
  上面三条路都不该走到 —— 那种情况由平台代建目录。请把这行日志贴给维护者。"

    else
      case "${probe}" in
        /vol*/@appdata|/vol*/@appconf|/vol*/@apptemp|/vol*/@apphome)
          # 走到这里说明 L5a 豁免没生效（例如老版本包），这是**我们的问题**，不是用户的
          fail "数据目录不可写：${d}
  这个路径还没建成，而它的父目录 ${probe} 是**平台目录**（属主 ${owner}，权限 ${mode}）。
  正常情况下，这类目录由应用中心在安装过程中创建、并交给本应用，不需要你处理。

  【请这样做】
    1) 如果你装的是旧版本（v1.0.5 之前），升级到 v1.0.5 或更新版本再装一次 —— 这是已知缺陷；
    2) 临时绕开：向导里「数据存放位置」改填存储空间里的普通目录（例如 /vol1/rustfs-data）
       或先按默认位置装完；
    3) 仍然不行，把这几行日志反馈给维护者。

  【请不要这样做】
    不要 chown / chmod ${probe} —— 那是平台目录，改动会波及其它应用。
"
          ;;
        *)
          fail "数据目录不可写：${d}
  这个路径还不存在，且父目录 ${probe} 不允许本应用写入（属主 ${owner}，权限 ${mode}）。

  【可以直接粘】
    sudo mkdir -p ${d}
    sudo chown -R ${uid}:${gid} ${d}
    sudo chmod 750 ${d}

  或者改用存储空间里的其它目录（例如 /vol1/rustfs-data）后重新安装。
"
          ;;
      esac
    fi
  fi

  # 可写但属主不是我们 —— 这在 fnOS 上是正常的（TrimACL 授权），说明一句，避免以后误判
  owner_uid="$(stat -c '%u' "${probe}" 2>/dev/null || echo '')"
  if [ "${defer_probe}" != "1" ] && [ -n "${owner_uid}" ] && [ "${owner_uid}" != "${uid}" ]; then
    say "提示：${probe} 的属主是 $(owner_desc "${probe}")，不是本应用用户（UID ${uid}），但实际可写（fnOS 的 TrimACL 已授权）。继续。"
  fi

  # ---- 剩余空间 ----
  avail_kb="$(df -Pk "${probe}" 2>/dev/null | awk 'NR==2{print $4}')"
  if [ -n "${avail_kb}" ]; then
    if [ "${avail_kb}" -lt 524288 ]; then
      fail "数据目录所在空间只剩 $(( avail_kb / 1024 )) MiB（${probe}），不足以存放对象数据。请换一个空间更大的目录。"
    fi
    if [ "${avail_kb}" -lt 4194304 ]; then
      warn "数据目录所在空间 ${probe} 只剩 $(( avail_kb / 1024 )) MiB。对象存储会持续增长，建议换到大容量存储空间。"
    fi
  fi
  return 0
}
# <<< END: data-dir-check
#
# 注意：build.md 里对本段有一条一致性检查（preflight §5c），确保 install_init 与 config_init
# 的这份逻辑不会各改一份、慢慢走偏。

# Docker 可用性：失败只告警，不阻断安装（真机首轮 F1）
# 原因：包用户对 /var/run/docker.sock 是否有权限、daemon 是否在跑，这两件事在安装期
# 都可能暂时不成立；用硬失败会让「Docker 尚未启动」变成「应用装不上」。
docker_selfcheck() {
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    return 0
  fi
  local why=""
  if ! command -v docker >/dev/null 2>&1; then
    why="未找到 docker 命令"
  elif [ -S /var/run/docker.sock ] && [ ! -r /var/run/docker.sock ]; then
    why="无权访问 /var/run/docker.sock（当前组：[$(id -nG 2>/dev/null || echo '?')]，需要 docker 组）"
  else
    why="Docker daemon 未运行"
  fi
  warn "Docker 不可用：${why}。安装将继续，但应用启动需要 Docker。"
  warn "排查：ls -l /var/run/docker.sock；id -nG；systemctl status docker"
  return 1
}

# 安装前：只读检查，不创建任何目录（Docker 相关的失败降级为告警）
trace "install_init begin"

# 1) 运行身份：compose 用 ${TRIM_UID}:${TRIM_GID} 覆盖容器用户，缺了就无法保证目录可写
[ -n "${TRIM_UID:-}" ] || fail "安装环境未提供 TRIM_UID，无法确定容器运行用户，已中止。请升级 fnOS 后重试。"
[ -n "${TRIM_GID:-}" ] || fail "安装环境未提供 TRIM_GID，无法确定容器运行用户，已中止。"

# 2) Docker / Compose：只告警
docker_selfcheck || true
if command -v docker >/dev/null 2>&1 && ! docker compose version >/dev/null 2>&1; then
  warn "docker compose 不可用（需要 Compose v2）。应用由应用中心托管启动，缺少它会导致启动失败。"
fi

# 3) 架构：首版只发 x86
arch="$(uname -m)"
case "${arch}" in
  x86_64|amd64) : ;;
  *) fail "本包仅支持 x86 设备（当前架构 ${arch}）。请不要在 ARM 设备上安装。" ;;
esac

# 4) 端口占用：9200 来自 manifest.service_port；控制台端口来自向导
port_busy() {
  if command -v ss >/dev/null 2>&1; then
    ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1$" && return 0 || return 1
  fi
  # 兜底：需要 bash 的 /dev/tcp；被 sh 调用时此分支不可用，故先用 ss
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3<&- 2>/dev/null; return 0; } || return 1
}

api_port="$(resolve_api_port)"
console_port="${wizard_console_port:-9201}"
case "${api_port}" in ''|*[!0-9]*) fail "service_port 非法：${api_port}" ;; esac
case "${console_port}" in ''|*[!0-9]*) fail "控制台端口非法：${console_port}" ;; esac
[ "${api_port}" != "${console_port}" ] || fail "S3 API 端口与控制台端口不能相同（都是 ${api_port}）。"
# API 端口可自定义（manifest.service_port 是静态值，改不了它；checkport 已设为 false，
# 端口检查完全由这里负责——所以必须自己把两个端口都查一遍）。
port_busy "${api_port}" && fail "S3 API 端口 ${api_port} 已被占用。
  处理（任选其一）：
    1) 换一个端口：安装向导里把「S3 API 端口」改成另一个空闲端口（例如 9400 —— 只是示例，别填 ${api_port}，它正被占用）；
    2) 停掉占用程序：sudo ss -lntp | grep -E ':${api_port}\\b' 看是谁，再停止它。
  当前正在监听该端口的进程：$(ss -lntp 2>/dev/null | awk -v p=":${api_port}" '$4 ~ p {print $6; exit}')"
port_busy "${console_port}" && fail "控制台端口 ${console_port} 已被占用。
  处理：安装向导里把「Web 控制台端口」改成空闲端口（例如 9301），或停掉占用程序
  （sudo ss -lntp | grep -E ':${console_port}\\b'）。"

# 5) 管理员凭据：只做格式校验（写入在 install_callback）
#    留空 = 由安装程序生成/沿用；填了就必须成对，且 AK 不能含 /（SigV4 scope 解析会错）
ak_in="${wizard_access_key:-}"
sk_in="${wizard_secret_key:-}"
if [ -n "${ak_in}" ] || [ -n "${sk_in}" ]; then
  [ -n "${ak_in}" ] && [ -n "${sk_in}" ] || fail "管理员账号与密码必须「两个都填」或「两个都留空」（现在只填了一个）。"
  printf '%s' "${ak_in}" | grep -Eq '^[A-Za-z0-9._-]{3,32}$' \
    || fail "管理员账号格式不对：只允许字母、数字、点、下划线、连字符，3–32 个字符，且不能包含斜杠 /。"
  case "${sk_in}" in
    *[[:space:]]*) fail "管理员密码不能包含空格。" ;;
  esac
  [ "${#sk_in}" -ge 8 ] || fail "管理员密码至少 8 个字符（建议 12 位以上）。"
  [ "${#sk_in}" -le 64 ] || fail "管理员密码最长 64 个字符。"
  [ "${ak_in}" != "${sk_in}" ] || fail "管理员账号与密码不能相同。"
  say "管理员账号：${ak_in}（密码已设置，不会回显）"
else
  say "管理员账号密码：留空，将沿用已有凭据，或由安装程序生成并在安装结果日志中显示一次。"
fi

# 6) 数据目录：可自定义；默认仍在应用数据目录下
data_subdir="${wizard_data_subdir:-data}"
case "${data_subdir}" in
  ''|*[!a-z0-9_-]*) fail "数据子目录名非法：${data_subdir}（只允许小写字母、数字、下划线、连字符）" ;;
esac
default_data_dir="${VAR_DIR}/${data_subdir}"
# v1.0.4-1 起：安装期固定使用默认位置，向导里不再提供数据目录选择。
# 若仍收到 wizard_data_dir（旧客户端 / 手工 --env / 复用旧配置），**忽略并提示**，不当作错误。
if [ -n "${wizard_data_dir:-}" ]; then
  warn "向导里传了数据目录「${wizard_data_dir}」，本版本安装期固定用默认位置 —— 已忽略该值。
  装好后可在「应用中心 → 本应用 → 设置」里改：先到「访问权限」授权该目录，再到「运行设置」改路径。"
fi
req="keep|"
req_action="${req%%|*}"
req_path="${req#*|}"
if [ "${req_action}" = "error" ]; then
  fail "数据目录设置无效：${req_path}
  处理：选择「改到指定目录」时，请在输入框里填完整绝对路径（例如 /vol1/my-rustfs-data）；"
fi
if [ "${req_action}" = "custom" ]; then
  data_dir="$(normalize_data_dir "${req_path}")"
else
  data_dir=""
fi
if [ -z "${data_dir}" ]; then
  data_dir="${default_data_dir}"
  say "数据目录：默认 ${data_dir}"
  warn "数据目录使用的是默认位置（应用数据目录）。卸载应用或安装失败回滚时，这个位置有被一并清理的风险；空间也通常较小。建议安装后在应用设置里改到大容量存储空间下的独立目录。"
else
  say "数据目录：自定义 ${data_dir}"
fi
# 允许清单 = 本项目自己的应用目录（默认位置就在 PKGVAR 下，必须放行）
check_data_dir "${data_dir}" "${VAR_DIR:-} ${CFG_DIR:-} ${TRIM_PKGTMP:-} ${TRIM_PKGHOME:-}"
case "${data_dir}" in
  "${TRIM_PKGTMP:-/nonexistent}"/*) warn "数据目录位于临时目录（${TRIM_PKGTMP}），重启后可能被清空。" ;;
esac

# 7) 空间：镜像解压约 299 MB。安装期 ${VAR_DIR} 往往还不存在，
#    所以按 [存储空间根 -> 安装卷 -> /vol1 -> VAR_DIR 父目录] 依次找一个存在的路径来测（真机首轮 F7）
space_probe=""
for p in "${TRIM_APPDEST_VOL:-}" "/vol1" "$(dirname "${VAR_DIR}")" "/"; do
  [ -n "${p}" ] && [ -d "${p}" ] && { space_probe="${p}"; break; }
done
avail_kb="$(df -Pk "${space_probe:-/}" 2>/dev/null | awk 'NR==2{print $4}')"
if [ -n "${avail_kb}" ] && [ "${avail_kb}" -lt 1048576 ]; then
  fail "可用空间不足 1 GiB（${space_probe} 当前 ${avail_kb} KiB），RustFS 镜像解压后约 299 MB，请先清理或换存储空间。"
fi
if [ -n "${avail_kb}" ] && [ "${avail_kb}" -lt 4194304 ]; then
  warn "可用空间 ${avail_kb} KiB（${space_probe}），仅够功能验证，不适合存放大量对象。"
fi

trace "install_init ok arch=${arch} api=${api_port} console=${console_port} data_dir=${data_dir}"
say "安装前检查通过：架构 ${arch}，端口 ${api_port}/${console_port} 空闲，数据目录 ${data_dir} 可写。"
exit 0
